rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // MEDIA COLLECTION (News, Sports, Music)
    // ============================================
    // Public read access to all published content
    // Only authenticated admins can create/update/delete
    match /media/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // ============================================
    // REQUESTS COLLECTION (Song Requests)
    // ============================================
    // Public can create requests
    // Admins can read, update, and delete all requests
    match /requests/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // ============================================
    // USERS COLLECTION (Optional - for future auth)
    // ============================================
    // Users can only read/write their own documents
    // Admins can read all user documents
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
      allow read: if request.auth != null && isAdmin(request.auth.uid);
    }

    // ============================================
    // ADMIN SETTINGS COLLECTION
    // ============================================
    // Only admins can access admin settings
    match /admin/{document=**} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user has admin custom claim
    function isAdmin(uid) {
      return request.auth.token.admin == true;
    }

    // Check if user owns the document
    function isOwner(uid) {
      return request.auth.uid == resource.data.userId;
    }

    // Validate that required fields are present
    function hasRequiredFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    // Validate media document structure
    function isValidMediaDocument() {
      let data = request.resource.data;
      return hasRequiredFields(['title', 'category', 'timestamp']) &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 255 &&
             data.category in ['news', 'sports', 'media'] &&
             data.timestamp is timestamp;
    }

    // Validate request document structure
    function isValidRequestDocument() {
      let data = request.resource.data;
      return hasRequiredFields(['song', 'name', 'timestamp']) &&
             data.song is string &&
             data.song.size() > 0 &&
             data.song.size() <= 255 &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 255 &&
             data.timestamp is timestamp;
    }

    // ============================================
    // RATE LIMITING (Optional Enhancement)
    // ============================================
    // Prevent spam by limiting requests per user
    function userRequestCount() {
      return firestore.query('requests')
        .where('userId', '==', request.auth.uid)
        .where('timestamp', '>=', now - duration.value(24, 'h'))
        .count().value() < 5;
    }
  }
}
